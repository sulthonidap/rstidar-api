APP_ENV=local
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medsend_go
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-something-random

# Penyimpanan foto bukti terima (POD): minio (default). "local" (disk) cuma buat tes offline.
STORAGE_DRIVER=minio
# minio: pakai Access Key khusus (bukan akun root). Bucket dibuat otomatis kalau belum ada.
# MINIO_ENDPOINT bisa host internal Docker (mis. medsent-objectstorage-xxxx:9000 + MINIO_USE_SSL=false)
# asal MINIO_PUBLIC_URL diisi alamat S3 API yang bisa dibuka browser/HP (link foto ditandatangani untuk alamat itu).
MINIO_ENDPOINT=
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=medsent
# Tes offline tanpa MinIO: STORAGE_DRIVER=local, file disimpan di UPLOAD_DIR (dilayani di /uploads)
UPLOAD_DIR=./storage/uploads
MINIO_REGION=us-east-1

# Jarak lewat jalan untuk tarif: server OSRM sendiri, mis. http://<host-osrm>:5000.
# (Server demo https://router.project-osrm.org cuma untuk coba-coba, dilarang untuk produksi.)
# Kosong = pakai perkiraan garis lurus × 1,3.
ROUTING_URL=
